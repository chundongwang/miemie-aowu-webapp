# miemieaowu shadow: DMIT terminates TLS and forwards to the Cloudflare Worker.
server {
    listen 80;
    listen [::]:80;
    server_name hk-test.miemieaowu.ai miemieaowu.ai www.miemieaowu.ai;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hk-test.miemieaowu.ai miemieaowu.ai www.miemieaowu.ai;

    ssl_certificate     /etc/letsencrypt/live/miemieaowu.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/miemieaowu.ai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 25m;
    access_log /var/log/nginx/shadow.access.log shadow;
    error_log  /var/log/nginx/shadow.error.log warn;

    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok shadow\n";
    }

    # Immutable build assets: cache on DMIT
    #
    # The cache key is $uri only and Cloudflare sends no `Vary: Accept-Encoding`,
    # so whatever encoding the *first* client negotiated (zstd for Chrome/curl)
    # was replayed to every later client. Safari/WKWebView, WeChat and older
    # Android WebViews cannot decode zstd, so CSS/JS silently failed for them
    # (2026-10-24 incident). Fetch identity bodies from Cloudflare, cache those,
    # and let nginx gzip per client.
    location /_next/static/ {
        include snippets/miemie-proxy.conf;
        proxy_set_header Accept-Encoding "";
        proxy_pass https://cf_edge;
        proxy_cache miemie;
        proxy_cache_valid 200 30d;
        proxy_cache_key $uri;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_hide_header Set-Cookie;
        gzip on;
        gzip_proxied any;
        gzip_vary on;
        gzip_comp_level 6;
        gzip_min_length 256;
        gzip_types text/css application/javascript text/javascript application/json
                   image/svg+xml application/wasm text/plain;
        # Hashed filenames: safe for clients to cache for a year (2xx/3xx only;
        # never stamp an upstream error as immutable)
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Shadow-Cache $upstream_cache_status always;
    }

    # Photos are immutable (public, max-age=1y from the Worker)
    location /api/photos/ {
        include snippets/miemie-proxy.conf;
        proxy_set_header Accept-Encoding "";
        proxy_pass https://cf_edge;
        proxy_cache miemie;
        proxy_cache_valid 200 30d;
        proxy_cache_key $uri;
        proxy_hide_header Set-Cookie;
        add_header X-Shadow-Cache $upstream_cache_status always;
    }

    # Videos: Range-aware caching in 1 MiB slices
    location /api/media/ {
        include snippets/miemie-proxy.conf;
        proxy_set_header Accept-Encoding "";
        slice 1m;
        proxy_set_header Range $slice_range;
        proxy_pass https://cf_edge;
        proxy_cache miemie;
        proxy_cache_key $uri$slice_range;
        proxy_cache_valid 200 206 30d;
        proxy_hide_header Set-Cookie;
        add_header X-Shadow-Cache $upstream_cache_status always;
    }

    # Everything else (pages, API, auth): pass through, no buffering (SSE)
    location / {
        include snippets/miemie-proxy.conf;
        proxy_pass https://cf_edge;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
