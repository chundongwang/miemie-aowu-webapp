{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadence SongPackage",
  "description": "Times are quarter-note beats. CLI additionally verifies sorted nonoverlapping events and song bounds.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "tempoBpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 400
    },
    "timeSignature": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        {
          "enum": [
            2,
            4,
            8,
            16
          ]
        }
      ],
      "items": false,
      "minItems": 2
    },
    "totalBeats": {
      "type": "number",
      "minimum": 1,
      "maximum": 100000
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "piano",
          "guitar",
          "bass"
        ]
      }
    },
    "melody": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "midi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "lyric": {
            "type": "string"
          }
        },
        "required": [
          "beat",
          "duration",
          "midi"
        ],
        "additionalProperties": false
      }
    },
    "chords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "beat": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "midi": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          }
        },
        "required": [
          "beat",
          "duration",
          "symbol",
          "midi"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startBeat": {
            "type": "number",
            "minimum": 0
          },
          "endBeat": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "startBeat",
          "endBeat"
        ],
        "additionalProperties": false
      }
    },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "startBeat": {
            "type": "number",
            "minimum": 0
          },
          "endBeat": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "text",
          "startBeat",
          "endBeat"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "manuallyCurated": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "license",
        "confidence",
        "manuallyCurated"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "artist",
    "description",
    "key",
    "tempoBpm",
    "timeSignature",
    "totalBeats",
    "instruments",
    "melody",
    "chords",
    "sections",
    "phrases",
    "provenance"
  ],
  "additionalProperties": false
}
