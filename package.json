{
  "name": "miemie-aowu-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply miemie-aowu-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply miemie-aowu-db --local",
    "start": "next start",
    "lint": "eslint",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "predev": "node scripts/copy-singing-worklet.mjs",
    "prebuild": "node scripts/copy-singing-worklet.mjs",
    "test:singing": "vitest run --config vitest.singing.config.ts",
    "singing:publish": "python3 scripts/publish-singing-library.py"
  },
  "dependencies": {
    "@capacitor/camera": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.2.3",
    "pitchy": "^4.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.82.2"
  }
}
